# Free Ollama API Gateway — переменные окружения (§14.2)
#
# Скопируйте в .env и заполните:  cp .env.example .env
# Файл .env в репозиторий не попадает (.gitignore).
#
# Все настройки переопределяются переменными вида FOA_СЕКЦИЯ__КЛЮЧ
# (два подчёркивания — разделитель). Примеры:
#   FOA_SECURITY__REQUIRE_TLS_FOR_NODES=true
#   FOA_DISCOVERY__SOURCES__CENSYS__ENABLED=true
#   FOA_HEALTH__CONSENT_RECHECK_INTERVAL_SECONDS=43200
# Приоритет: значения по умолчанию < config.yaml < переменные окружения.

# --------------------------------------------------------------------------- #
# Секреты: только из окружения или внешнего secret manager (Vault, AWS/GCP/Azure,
# Kubernetes Secrets с шифрованием at-rest) (§14.2). Значения в журнал, в
# ответы API и в репозиторий не пишутся никогда (§12.2).
# --------------------------------------------------------------------------- #

# База данных реестра. Пусто → sqlite+aiosqlite:///data/foagw.sqlite3 (стенд).
# Для прода: postgres+asyncpg. Формат без префикса драйвера нормализуется сам.
GATEWAY_DB_URL=postgresql+asyncpg://foa:CHANGE_ME@postgres:5432/foa

# Пароль Postgres для docker-compose.yml: подставляется и в FOA_STORAGE__DATABASE_URL
# реплик шлюза, и в POSTGRES_BOOTSTRAP пароль контейнера postgres. compose
# откажет в запуске без него (${POSTGRES_PASSWORD:?...}).
POSTGRES_PASSWORD=

# Redis для распределённых лимитов и квот (§12.4). Пусто → лимиты в памяти
# процесса (подходит только для одной реплики шлюза).
GATEWAY_REDIS_URL=redis://redis:6379/0

# Pepper для хэширования пользовательских API-ключей (§12.4.1).
# Смена значения делает все выданные ключи недействительными — выдавайте заново.
GATEWAY_JWT_SECRET=CHANGE_ME_LONG_RANDOM_VALUE

# Идентификатор шлюза (пишется в consent.json и DNS-подтверждения, §5.3).
# Должен совпадать с тем, что указывают владельцы узлов.
GATEWAY_ID=gateway_main

# --------------------------------------------------------------------------- #
# Админ-контур (§9.6). Пустой admin_token = контур закрыт (fail-closed).
# --------------------------------------------------------------------------- #

# Токен администратора: управление узлами, ключами, конфигурацией, discovery.
FOA_ADMIN_TOKEN=

# Токен аудитора: только чтение (§2.2 роль auditor).
FOA_AUDITOR_TOKEN=

# Владелецский токен self-service (§2.2, §5.5): узлы, принадлежащие owner_ref.
FOA_OWNER_TOKEN=
FOA_OWNER_REF=owner_change_me

# Соль псевдонима клиента (X-FOA-Client-Hash, §8.5.3). Требует только
# непредсказуемости: в продакшене значение не должно остаться дефолтным.
FOA_SECURITY__CLIENT_HASH_SALT=

# --------------------------------------------------------------------------- #
# Ключи поисковых платформ (§4.4.1). Источники ОТКЛЮЧЕНЫ по умолчанию; ключ без
# заполненного allowed_scopes не даёт включить источник (§4.4.3, проверка на старте).
# --------------------------------------------------------------------------- #
CENSYS_API_ID=
CENSYS_API_SECRET=
GREYNOISE_API_KEY=
ZOOMEYE_API_KEY=
NATLAS_API_KEY=
NATLAS_API_ENDPOINT=
CRIMINAL_IP_API_KEY=

# --------------------------------------------------------------------------- #
# Сервер
# --------------------------------------------------------------------------- #

# В Docker/compose привязка 0.0.0.0; наружу — только через ingress с TLS (§14.1).
FOA_SERVER__HOST=127.0.0.1
FOA_SERVER__PORT=8080
FOA_STORAGE__DATA_DIR=data
FOA_OBSERVABILITY__LOG_LEVEL=INFO

# OpenAI-совместимый контракт /v1/* (README «OpenAI-совместимый API»): по умолчанию
# включён, отключение не влияет на Ollama API и на требование согласия.
FOA_SERVER__OPENAI_API_ENABLED=true

# Наведение схемы БД (README «Миграции»): create_all | alembic | off.
# Для продакшена с регулярными апгрейдами — alembic; переход с create_all
# выполняется явно: foa-gateway --config ... --stamp
FOA_STORAGE__MIGRATIONS=create_all
